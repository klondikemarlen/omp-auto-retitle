  "bugs": {
    "url": "https://github.com/klondikemarlen/omp-auto-retitle/issues"
  },
  "qna": false,
  "keywords": [
    "omp",
    "oh-my-pi",
    "plugin",
    "extension",
    "session-title"
  ],
  "files": [
    "index.js",
    "src/",
    "prompts/",
    "README.md",
    "LICENSE"
  ],
  "omp": {
    "extensions": [
      "./index.js"
    ]
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "16.3.11"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
